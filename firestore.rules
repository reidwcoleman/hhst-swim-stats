rules_version = '2';

// HHST Swim Stats — Firestore security rules.
// Anyone can READ swimmer data (the parent lookup is essentially a public
// query). Only an authenticated admin can WRITE.
service cloud.firestore {
  match /databases/{database}/documents {

    match /swimmers/{key} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
