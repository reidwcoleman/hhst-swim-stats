rules_version = '2';

// Merged ruleset for famsync-62653.
// - FamSync iOS app collections (users/, families/) require an authenticated user.
// - HHST swim-stats web collections allow public read so unauthenticated parents
//   can look up swimmers; only an authenticated admin can write.
// No catch-all deny — Firestore denies by default if no rule matches.
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- FamSync iOS app --------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /families/{familyId} {
      allow read, write: if request.auth != null;

      match /events/{eventId} { allow read, write: if request.auth != null; }
      match /tasks/{taskId} { allow read, write: if request.auth != null; }
      match /categories/{categoryId} { allow read, write: if request.auth != null; }
      match /groceryItems/{itemId} { allow read, write: if request.auth != null; }
      match /customLists/{listId} { allow read, write: if request.auth != null; }
      match /customLists/{listId}/items/{itemId} { allow read, write: if request.auth != null; }
      match /mealPlans/{planId} { allow read, write: if request.auth != null; }
      match /recipes/{recipeId} { allow read, write: if request.auth != null; }
      match /chores/{choreId} { allow read, write: if request.auth != null; }
      match /choreRotations/{rotationId} { allow read, write: if request.auth != null; }
      match /bulletinPosts/{postId} { allow read, write: if request.auth != null; }
      match /monster/{monsterId} { allow read, write: if request.auth != null; }
      match /monsterMissions/{missionId} { allow read, write: if request.auth != null; }
      match /memories/{memoryId} { allow read, write: if request.auth != null; }
      match /inbox/{messageId} { allow read, write: if request.auth != null; }
    }

    // -------- HHST Swim Stats web app --------
    match /swimmers/{key} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /hhst_rosters/{key} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /hhst_meet_times/{key} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-file upload registry (admin "Uploaded files" / per-file remove).
    // Only the authenticated coach ever reads or writes it.
    match /hhst_uploads/{key} {
      allow read, write: if request.auth != null;
    }

    // Team records — updated automatically as new fastest times are uploaded.
    // Public read (records.html renders it for parents/swimmers); only the
    // authenticated coach can write (via ingest / historical seed).
    //   /hhst_records/{id}          → the CURRENT record for one age group + event
    //   /hhst_records/{id}/history  → every previous holder, archived on break
    // Records are permanent; the history subcollection is public-read too so
    // the records page can show a full timeline.
    match /hhst_records/{key} {
      allow read: if true;
      allow write: if request.auth != null;
      match /history/{historyId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Relay results — one doc per relay swim (place/time/lineup/event).
    // Public read (relays.html + a swimmer's own dashboard both read it);
    // only the authenticated coach can write (via the relay CSV import).
    match /hhst_relay_results/{key} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-file relay upload registry (admin "Uploaded relay files" / per-file
    // remove). Only the authenticated coach ever reads or writes it.
    match /hhst_relay_uploads/{key} {
      allow read, write: if request.auth != null;
    }
  }
}
